---
// Monochrome brand glyph (simple-icons geometry, LinkedIn hand-drawn).
// Renders in currentColor; `--brand` holds the official color for hover states.
import { brandColors } from '../data/brands';

const icons = import.meta.glob<string>('../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true });



interface Props {
  name: keyof typeof brandColors | string;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 18, class: className, label } = Astro.props;
const raw = icons[`../assets/icons/${name}.svg`] ?? '';
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
  class:list={['brand-icon', className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  style={`--brand:${brandColors[name] ?? 'currentColor'}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={inner}
/>
